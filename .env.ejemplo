# Copia este archivo como .env.local y llena los valores

# Postgres (Supabase → Project Settings → Database → Connection string → "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Cadena larga y aleatoria (ej. salida de: openssl rand -hex 32)
SESSION_SECRET=

# Archivos (Supabase → Project Settings → API). Sin estas variables se guardan en ./almacen
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=archivos

# Solo para la migración
AIRTABLE_TOKEN=
